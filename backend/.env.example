# Copy to backend/.env for local (non-docker) runs.

DATABASE_URL=postgresql+psycopg://mde:mde@localhost:5432/mde
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=tracks
REDIS_URL=redis://localhost:6379/0

CORS_ORIGINS=http://localhost:3000

# Free client id from https://devportal.jamendo.com/
JAMENDO_CLIENT_ID=

CLAP_MODEL_ID=laion/larger_clap_music_and_speech
